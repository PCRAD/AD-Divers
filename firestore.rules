rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsRecord() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 32
        && request.resource.data.photo is string;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 32
        && request.resource.data.photo is string;
      allow delete: if false;
    }

    match /dives/{diveId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.place is string
        && request.resource.data.place.size() > 0
        && request.resource.data.place.size() <= 120
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0
        && request.resource.data.country.size() <= 80
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 10;
      allow update: if ownsRecord()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 10;
      allow delete: if ownsRecord();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 3000
        && request.resource.data.answers == 0
        && request.resource.data.votes == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.votes == resource.data.votes + 1;
      allow delete: if ownsRecord();
    }

    match /gear/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5;
      allow update: if ownsRecord()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsRecord();
    }
  }
}
